GNANI_API_KEY=
# Timbre v3 voice used for alerts when no family voice is enrolled
ALERT_VOICE=Shivani
# access token for the app; open https://<lan-ip>:8443/?t=<token> once on the phone (python -m app.serve)
APP_TOKEN=
# honeypot mode: Groq LLM writes the persona's replies
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
HONEYPOT_VOICE=Vasudha
# who the honeypot plays; match the honeypot voice (elderly woman / elderly man)
HONEYPOT_PERSONA=elderly woman
